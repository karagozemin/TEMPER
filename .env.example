# ── Minds (Animoca) ─────────────────────────────────────────────
# When both of these are set, TEMPER uses the real Minds client.
MINDS_API_KEY=
MINDS_API_URL=
# Optional: a stable Mind id / alias. Falls back to temper-demo-community.
TEMPER_MIND_ID=temper-demo-community

# ── Telegram ────────────────────────────────────────────────────
# Set to run the live Telegram observer / intervention bot.
TELEGRAM_BOT_TOKEN=
# Webhook secret for /api/telegram. Leave empty to use long polling in scripts.
TELEGRAM_WEBHOOK_SECRET=

# ── Storage ─────────────────────────────────────────────────────
# SQLite file path. Defaults to ./data/temper.db
DATABASE_URL=

# ── Demo / local development ────────────────────────────────────
# When true (and no Minds keys are set), a deterministic, clearly-labelled
# local evaluator powers the Maya / Chris contrast so the demo runs offline.
# It never fabricates a real Minds verdict.
DEMO_MODE=true
DEMO_COMMUNITY_ID=temper-demo-community
