# ── Minds (Animoca) ─────────────────────────────────────────────
# Official @animocabrands/minds-client-lib connects to the Builder API
# automatically — no URL needed. Provide the Builder API key and the Mind id.
MINDS_BUILDER_API_KEY=
TEMPER_MIND_ID=temper-demo-community

# ── Telegram ────────────────────────────────────────────────────
# Set to run the live Telegram observer / intervention bot.
TELEGRAM_BOT_TOKEN=
# Webhook secret for /api/telegram. Leave empty to use long polling in scripts.
TELEGRAM_WEBHOOK_SECRET=
# Optional: group chat id so the scenario/intervention posts the redirect there.
DEMO_CHAT_ID=

# ── Storage ─────────────────────────────────────────────────────
# SQLite file path (file: URLs and plain paths both work).
DATABASE_URL=file:./temper.db

# ── Demo / offline fallback ─────────────────────────────────────
# DEMO_MODE=true  → deterministic offline evaluator (no Minds calls).
# DEMO_MODE=false → real Minds flow (requires MINDS_BUILDER_API_KEY).
# When neither applies, TEMPER degrades to OBSERVE and never intervenes.
DEMO_MODE=true
DEMO_COMMUNITY_ID=temper-demo-community

# ── Optional convergence tuning (defaults: 5 sources, 120s) ─────
# CONVERGENCE_MIN_SOURCES=5
# CONVERGENCE_WINDOW_SECONDS=120
